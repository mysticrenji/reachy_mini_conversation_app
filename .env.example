# OpenAI API Configuration (only needed with --provider openai)
OPENAI_API_KEY=

# ElevenLabs API Configuration (only needed with --provider elevenlabs)
ELEVENLABS_API_KEY=

# Optional: Use a pre-configured ElevenLabs agent (leave empty to use dynamic config)
ELEVENLABS_AGENT_ID=

# Voice selection (default: rachel)
# Available voices: rachel, clyde, domi, dave, fin, sarah, antoni, thomas, charlie, emily, elli, callum, charlotte, matilda, alice
ELEVENLABS_VOICE=rachel

# Conversation model (default: eleven_turbo_v2_5)
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Local vision model (only used with --local-vision CLI flag)
LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct

# Cache for local VLM (only used with --local-vision CLI flag)
HF_HOME=./cache

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# To select a specific profile with custom instructions and tools, to be placed in profiles/<myprofile>/__init__.py
REACHY_MINI_CUSTOM_PROFILE="example"